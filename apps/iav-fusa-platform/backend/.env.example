# ============================================================
# IAV FuSa Platform — 环境变量配置模板
# 复制为 .env 后填入实际值
# ============================================================

# LLM 模型（DeepAgents init_chat_model 格式）
DEEPAGENTS_MODEL=anthropic:claude-sonnet-4-6

# Anthropic API Key（使用 Claude 时必填）
ANTHROPIC_API_KEY=sk-ant-...

# ─── Dify RAG 配置 ────────────────────────────────────────
DIFY_API_URL=http://localhost:5001
DIFY_API_KEY=app-...
DIFY_DATASET_HARA=
DIFY_DATASET_FMEA=
DIFY_DATASET_FTA=
DIFY_DATASET_FAILURE_MODES=
DIFY_DATASET_HISTORICAL=
DIFY_DATASET_COMPANY=

# ─── 数据库 ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fusa

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MinIO 对象存储 ────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ─── LangSmith 审计追踪 ───────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=iav-fusa-platform

# ─── 安全阈值 ─────────────────────────────────────────────
# FMEA RPN 超过此值时触发人工审批门
RPN_THRESHOLD=100
